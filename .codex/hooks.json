{
  "description": "Persist and resume the Stark migration handoff through Beads.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/with-project-node.sh -- node scripts/codex-session-hook.mjs resume",
            "commandWindows": "C:\\LocalData\\DEV\\Software\\Git\\usr\\bin\\bash.exe --noprofile --norc -lc \"bash scripts/with-project-node.sh -- node scripts/codex-session-hook.mjs resume\"",
            "statusMessage": "Loading Stark migration handoff",
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/with-project-node.sh -- node scripts/codex-session-hook.mjs precompact",
            "commandWindows": "C:\\LocalData\\DEV\\Software\\Git\\usr\\bin\\bash.exe --noprofile --norc -lc \"bash scripts/with-project-node.sh -- node scripts/codex-session-hook.mjs precompact\"",
            "statusMessage": "Saving Stark migration handoff before compaction",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
