{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "showcase": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "allowedCommonJsDependencies": ["validator", "@nationalbankbelgium/stark-core"],
            "index": {
              "input": ".stark/generated/index.html",
              "output": "index.html"
            },
            "browser": "src/main.browser.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": ["src/polyfills.browser.ts"],
            "define": {
              "ENV": "\"development\"",
              "HMR": "false"
            },
            "optimization": false,
            "sourceMap": true,
            "namedChunks": true,
            "assets": [
              {
                "glob": "mdi.svg",
                "input": "node_modules/@mdi/angular-material",
                "output": "assets/material-icons"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "**/*",
                "input": "src/assets-base",
                "output": "."
              },
              {
                "glob": "**/*",
                "input": "node_modules/@nationalbankbelgium/stark-core/assets",
                "output": "assets/stark-core"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@nationalbankbelgium/stark-ui/assets",
                "output": "assets/stark-ui"
              }
            ],
            "styles": [
              "node_modules/@nationalbankbelgium/stark-core/assets/css/pre-load-style.css",
              "node_modules/prismjs/themes/prism-okaidia.css",
              "node_modules/basscss/css/basscss.css",
              "src/styles/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules"]
            },
            "scripts": [],
            "deployUrl": "/",
            "baseHref": "/"
          },
          "configurations": {
            "hmr": {
              "define": {
                "ENV": "\"development\"",
                "HMR": "true"
              },
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.hmr.ts"
                }
              ]
            },
            "development": {},
            "unit-test": {
              "polyfills": ["src/polyfills.browser.ts", "zone.js/testing"]
            },
            "production": {
              "optimization": true,
              "define": {
                "ENV": "\"production\"",
                "HMR": "false"
              },
              "namedChunks": false,
              "subresourceIntegrity": true,
              "outputHashing": "all",
              "sourceMap": false,
              "aot": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "ghpages": {
              "deployUrl": "https://stark-dummy-deploy-url.invalid/",
              "baseHref": "https://stark-dummy-base-href.invalid/"
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "showcase:build",
            "headers": {
              "Access-Control-Allow-Origin": "*",
              "Content-Security-Policy": "base-uri 'self' ; child-src 'self' ; connect-src 'self' ws://localhost:3000 http://localhost:5000 http://localhost:5001 http://localhost:5002 http://localhost:4000 https://nationalbankbelgium.github.io ; font-src 'self' ; form-action 'self' http://localhost:5000/myAwesomeUpload ; frame-src 'self' ; frame-ancestors 'none' ; img-src 'self' data: image/png ; media-src 'self' ; object-src 'self' data:",
              "X-Content-Security-Policy": "base-uri 'self' ; child-src 'self' ; connect-src 'self' ws://localhost:3000 http://localhost:5000 http://localhost:5001 http://localhost:5002 http://localhost:4000 https://nationalbankbelgium.github.io ; font-src 'self' ; form-action 'self' http://localhost:5000/myAwesomeUpload ; frame-src 'self' ; frame-ancestors 'none' ; img-src 'self' data: image/png ; media-src 'self' ; object-src 'self' data:",
              "X-WebKit-CSP": "base-uri 'self' ; child-src 'self' ; connect-src 'self' ws://localhost:3000 http://localhost:5000 http://localhost:5001 http://localhost:5002 http://localhost:4000 https://nationalbankbelgium.github.io ; font-src 'self' ; form-action 'self' http://localhost:5000/myAwesomeUpload ; frame-src 'self' ; frame-ancestors 'none' ; img-src 'self' data: image/png ; media-src 'self' ; object-src 'self' data:",
              "X-Frame-Options": "deny",
              "X-Xss-Protection": "1; mode=block",
              "X-Content-Type-Options": "nosniff"
            },
            "port": 3000,
            "open": true
          },
          "configurations": {
            "hmr": {
              "hmr": true,
              "buildTarget": "showcase:build:hmr"
            },
            "production": {
              "buildTarget": "showcase:build:production"
            },
            "development": {
              "buildTarget": "showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "showcase:build"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "eslint.config.js",
            "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "showcase:build:unit-test",
            "runner": "vitest",
            "runnerConfig": "vitest.config.mjs",
            "setupFiles": ["base.vitest.spec.ts"],
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "showcase",
      "style": "scss"
    },
    "@schematics/angular:directive": {
      "prefix": "showcase"
    }
  },
  "cli": {
    "schematicCollections": ["@angular-eslint/schematics"],
    "analytics": false
  }
}
